      "source_start": 0.085714,
      "source_end": 4.945669,
      "clip": "audio/nl/scene/warm.mp3",
      "duration": 4.86,
      "script": "Je hoeft het vandaag niet allemaal te weten. Laten we samen de eerste stap zetten.",
      "sha256": "028c6a77611adb06b05a0012e94a383462c0571bdad0a7d5101a79c118e3f490"
    },
    {
      "language": "nl",
      "mode": "scene",
      "emotion": "excited",
      "position": 2,
      "source": "ElevenLabs_2026-10-03T21_28_40_Ruth - Professional female voiceover_pvc_sp100_s30_sb83_v4.mp3",
      "source_start": 6.021451,
      "source_end": 10.827914,
      "clip": "audio/nl/scene/excited.mp3",
      "duration": 4.806,
      "script": "Het gaat eindelijk gebeuren! Dit is het moment waarop we hebben gewacht.",
      "sha256": "cfe1e062bae6b1634e97979e6cb917756aedb5f426bcb2c510a54cd9358887c1"
    },
    {
      "language": "nl",
      "mode": "scene",
      "emotion": "curious",
      "position": 3,
      "source": "ElevenLabs_2026-10-03T21_28_40_Ruth - Professional female voiceover_pvc_sp100_s30_sb83_v4.mp3",
      "source_start": 12.360227,
      "source_end": 16.618458,
      "clip": "audio/nl/scene/curious.mp3",
      "duration": 4.259,
