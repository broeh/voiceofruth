    {
      "language": "en",
      "mode": "scene",
      "emotion": "warm",
      "position": 1,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 0,
      "source_end": 3.961814,
      "clip": "audio/en/scene/warm.mp3",
      "duration": 3.962,
      "script": "You don’t have to figure it all out today. Let’s take the first step together.",
      "sha256": "8cc580a9cfc599b50ff3cb8be338cf9b72ad7117f0453ef800d43ca16e441822"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "excited",
      "position": 2,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 5.605034,
      "source_end": 9.879411,
      "clip": "audio/en/scene/excited.mp3",
      "duration": 4.274,
      "script": "It’s finally happening! This is the moment we’ve been waiting for.",
      "sha256": "bdcc6dc4e2faafebac04dbbe8828634095ceb51a15cc8d6a0ff8ea64105b6ece"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "curious",
      "position": 3,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 11.592313,
      "source_end": 15.455215,
      "clip": "audio/en/scene/curious.mp3",
      "duration": 3.863,
      "script": "That little door wasn’t here yesterday. Shall we see what’s behind it?",
      "sha256": "ba6c0dd6927c720921ef51d7c3600316658e26ad04162bf7c4d4c571d1205ee0"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "playful",
      "position": 4,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 17.27551,
      "source_end": 22.428436,
      "clip": "audio/en/scene/playful.mp3",
      "duration": 5.153,
      "script": "I promised I wouldn’t eat the last biscuit. I made no promises about the cake.",
      "sha256": "4275ea6f0150ad1d4ad977044f3bf8e406b355851105b68505b2cc214bfcd064"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "confident",
      "position": 5,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 24.284717,
      "source_end": 28.438481,
      "clip": "audio/en/scene/confident.mp3",
      "duration": 4.155,
      "script": "You’ve done the hard part. Now let’s make your next move count.",
      "sha256": "4599fcdf80c34d85c156d19edf2b8388463d2801d8890e7160c6ff623e96788b"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "amazed",
      "position": 6,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 30.362608,
      "source_end": 35.049887,
      "clip": "audio/en/scene/amazed.mp3",
      "duration": 4.687,
      "script": "The whole sky is glowing. I’ve never seen anything like it.",
      "sha256": "b6e157f79fdb12fd2242bceec1d95b1cf48cc4bde3ce1e9b78eb6de15876b6c3"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "tender",
      "position": 7,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 36.953946,
      "source_end": 41.177755,
      "clip": "audio/en/scene/tender.mp3",
      "duration": 4.224,
      "script": "I kept your drawing all these years. It still makes me smile.",
      "sha256": "2969cc5a489b2be9c720454e1e3e3a23020ade8c0b49118f2fa9f01900ebc761"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "sad",
      "position": 8,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 43.3061,
      "source_end": 47.358935,
      "clip": "audio/en/scene/sad.mp3",
      "duration": 4.053,
      "script": "I still set out two cups sometimes. Then I remember.",
      "sha256": "9427905f2210f2ef10b3dcc5e7ce5cfc6be33131cac4e76e91639c709293b55b"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "frustrated",
      "position": 9,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 49.453447,
      "source_end": 53.588095,
      "clip": "audio/en/scene/frustrated.mp3",
      "duration": 4.135,
      "script": "I followed every instruction. So why is the screen still blank?",
      "sha256": "4e0ea47baf14ec1e9819db845ef1cb186328d2bc17586520334130dbc50c2141"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "urgent",
      "position": 10,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 55.532109,
      "source_end": 59.684671,
      "clip": "audio/en/scene/urgent.mp3",
      "duration": 4.153,
      "script": "The last train leaves in one minute. We need to move now.",
      "sha256": "83264099999c78bd2c28d35822cf415d2556ee70de497fb85c6c173ed81ef8be"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "whisper",
      "position": 11,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 61.660431,
      "source_end": 65.242925,
      "clip": "audio/en/scene/whisper.mp3",
      "duration": 3.582,
      "script": "Come a little closer. I have a tiny secret to tell you.",
      "sha256": "e2549b3519a4bb1ab4a35164a447164988c06967f31e81010ebf075d58e2e3ab"
    },
    {
      "language": "en",
      "mode": "scene",
      "emotion": "calm",
      "position": 12,
      "source": "ElevenLabs_2026-10-03T21_26_37__s50_v4.mp3",
      "source_start": 67.292562,
      "source_end": 71.874626,
      "clip": "audio/en/scene/calm.mp3",
      "duration": 4.582,
      "script": "Let your shoulders soften. There is nothing you need to solve right now.",
      "sha256": "8675062013de5f5114ba1c258a528420a983471a9e32ba191afa98f8dde9d8f0"
    },
    {
      "language": "nl",
      "mode": "scene",
      "emotion": "warm",
      "position": 1,
